<?xml version="1.0" encoding="utf-8"?>
<!-- Molde visual de UNA sola fila del ListView (se repite por cada jugador) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- Columna 1: Nombre (ocupa 3/7 partes del espacio sobrante) -->
    <TextView
        android:id="@+id/tvNombreItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Columna 2: País (ocupa 2/7 partes) -->
    <TextView
        android:id="@+id/tvNacionalidadItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:textSize="14sp" />

    <!-- Columna 3: Puntuación (ocupa 2/7 partes) -->
    <TextView
        android:id="@+id/tvPuntuacionItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:textSize="14sp" />

    <!-- Columna 4: Bandera (tamaño fijo para que todas salgan uniformes) -->
    <ImageView
        android:id="@+id/imgBanderaItem"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"
        android:contentDescription="Bandera" />


</LinearLayout>